<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiled code samples for the docs site. Every C# block under www/docs/articles is a
       [!code-csharp[](...#region)] reference into this project, so a sample that stops compiling
       or stops passing breaks the build instead of the docs silently drifting from the library. -->

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>Prague.Samples</RootNamespace>
    <!-- Consumers with doc generation on compile our generated sources under the XML-doc checks
         (CS1570 malformed XML, CS1574 unresolved cref, ...). This project references ASP.NET Core, so it
         gets the full generated surface (incl. DataCachesJsonExtensions); keep the checks on here so
         generator doc text cannot regress. Missing-comment warnings (CS1591) are noise for samples. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
    <PackageReference Include="NUnit" Version="4.4.0"/>
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1"/>
    <!-- HowTo/InspectOverHttp and the tutorial's endpoint run an in-process ASP.NET Core host (TestServer);
         HowTo/HealthAndMetrics and the kafka-integration snippet register the OpenTelemetry meter provider. Neither needs a broker. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="$(MicrosoftRuntimeVersion)"/>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Prague.Core\Prague.Core.csproj"/>
    <ProjectReference Include="..\..\src\Prague.Attributes\Prague.Attributes.csproj"/>
    <ProjectReference Include="..\..\src\Prague.Codegen\Prague.Codegen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\src\Prague.Kafka\Prague.Kafka.csproj"/>
    <ProjectReference Include="..\..\src\Prague.Api\Prague.Api.csproj"/>
  </ItemGroup>

  <PropertyGroup>
    <!-- MessagePack generates a per-assembly resolver; Prague.Kafka exposes its copy via
         InternalsVisibleTo, so this project sees two same-named types (benign CS0436). -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
</Project>
